# Práctica 7
Edad<-c(67, 40, 68, 64, 47, 71, 54, 59, 46, 52, 57, 63, 45, 55, 48, 51, 48, 77, 38, 61)
PA <-c(185, 154, 198, 189, 168, 200, 166, 190, 155, 172, 180, 173, 176, 172, 150, 176, 155, 192, 154, 185)
plot(Edad, PA, pch =16); # utilizando puntos rellenos
plot(PA~Edad, pch=16)
modelo <- lm(PA~Edad)
coef(modelo)
model.matrix(modelo)
A <- model.matrix(modelo)
beta <- solve(t(A)%*%A)%*%t(A)%*%PA
print(beta)
print(beta)
summary(modelo)
info$Estimate[2] - abs(qt(0.025,(20-2)))*info$Std..Error[2]
info <- summary(modelo)$coefficients
info$Estimate[2] - abs(qt(0.025,(20-2)))*info$Std..Error[2]
info <- summary(modelo$coefficients)
info$Estimate[2] - abs(qt(0.025,(20-2)))*info$Std..Error[2]
