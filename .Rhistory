col="lightblue",
main="Distribución de BMI",
xlab="BMI")
library(ggplot2)
ggplot(data, aes(x = BMI)) +
geom_histogram(bins = 30, fill = "red", color = "black") +
facet_wrap(~ Workout_Type, scales = "free_y") +
theme_minimal()
